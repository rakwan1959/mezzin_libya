<?xml version="1.0" encoding="utf-8"?>
<!--
  ألوان بطاقة الإشعار المخصّصة (RemoteViews).
  ملاحظة: اللون الفعلي للبطاقة يُمرَّر وقت التشغيل (لون الصلاة أو الكحلي
  الملكي) عبر setColorFilter، فالقيم هنا للقراءة الافتراضية فقط.
-->
<resources>
    <!--
      خلفية بطاقة الإشعار في شريط النظام — **أسود**.
      (والكحلي الملكي #002855 باقٍ هوية التطبيق في حوارات وتنبيهات الواجهة
      داخل التطبيق؛ هذا المورد يخصّ شريط الإشعارات وحده.)
    -->
    <color name="notif_card_black">#FF000000</color>

    <!-- ذهبي التطبيق — شريط التمييز والنص الثانوي داخل البطاقة -->
    <color name="notif_gold">#FFDFBA6B</color>

    <!-- نصوص البطاقة: **أبيض** للعنوان والنص معاً — هوية موحّدة على الكحلي -->
    <color name="notif_text_primary">#FFFFFFFF</color>
    <color name="notif_text_secondary">#FFFFFFFF</color>

    <!-- خلفية شبه شفافة للقرص الدائري خلف أيقونة المسجد (تُلوَّن وقت التشغيل) -->
    <color name="notif_icon_disc">#26FFFFFF</color>

    <!-- فاصل رقيق أعلى تذييل البطاقة الموسّعة -->
    <color name="notif_divider">#33FFFFFF</color>
</resources>
