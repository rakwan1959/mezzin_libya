<?xml version="1.0" encoding="utf-8"?>
<!--
  حبّة زر الإجراء داخل البطاقة (حبة ذهبية شبه شفافة بحدّ رقيق).

  الألوان ثابتة عمداً لا تُلوَّن وقت التشغيل: البطاقة نفسها قد تكون كحلية ملكية
  أو لون أي صلاة، والحبّة شبه الشفافة مع نصّها الذهبي تُقرأ بوضوح على كل الدرجات
  — فلا نحتاج حساب تباين لكل حالة، ولا يمكن أن تسقط إلى لون غير مقروء.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#26DFBA6B" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#59DFBA6B" />
</shape>
