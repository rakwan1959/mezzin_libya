<?xml version="1.0" encoding="utf-8"?>
<!--
  خلفية بطاقة الإشعار — **أسود** بزوايا دائرية (طلب المستخدم).

  تُوضع على الجذر كطبقة ثانية تحت بطاقة التلوين الديناميكي (notif_card_bg):
   إن نجح تلوين الصورة (setColorFilter) فلا يظهر هذا اللون إطلاقاً، وإن فشل لأي
   سبب على جهاز معيّن تبقى البطاقة سوداء أنيقة بدل خلفية النظام البيضاء التي قد
   تجعل النصّ الأبيض غير مقروء.

  وكحلي التطبيق الملكي `#002855` باقٍ هويةً للتطبيق في الحوارات والتنبيهات
  داخل الواجهة — التغيير هنا مقصور على بطاقة شريط الإشعارات.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/notif_card_black" />
    <corners android:radius="24dp" />
</shape>
