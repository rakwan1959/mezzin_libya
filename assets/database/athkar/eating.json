    "id" : 603,
    "key" : ""
   },
  {
    "title" : "",
    "body" : "الحمد لله كثيراً طيباً مباركاً فيه, الحمد لله الذي كفانا, وأروانا غير مَكْفِيٍّ ولا مَكْفورٍ",
    "repetition" : "",
    "narrator" : "مختصر البخاري 2157",
    "reason" : "",
